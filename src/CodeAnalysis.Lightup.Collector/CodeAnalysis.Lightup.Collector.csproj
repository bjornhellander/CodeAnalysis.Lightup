<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\CodeAnalysis.Lightup.Definitions\CodeAnalysis.Lightup.Definitions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="NuGet.Frameworks" Version="7.9.0" />
		<PackageReference Include="System.Composition" Version="10.0.14" />
		<PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.14" />
	</ItemGroup>

	<!-- The Roslyn versions to collect type information from -->
	<ItemGroup>
		<RoslynVersion Include="1.2.0;1.3.0" />
		<RoslynVersion Include="2.0.0;2.1.0;2.2.0;2.3.0;2.4.0;2.6.0;2.7.0;2.8.0;2.9.0;2.10.0" />
		<RoslynVersion Include="3.0.0;3.1.0;3.2.0;3.3.0;3.4.0;3.5.0;3.6.0;3.7.0;3.8.0;3.9.0;3.10.0;3.11.0" />
		<RoslynVersion Include="4.0.1;4.1.0;4.2.0;4.3.0;4.4.0;4.5.0;4.6.0;4.7.0;4.8.0;4.9.2;4.10.0;4.11.0;4.12.0;4.13.0;4.14.0" />
		<RoslynVersion Include="5.0.0;5.3.0;5.6.0;5.9.0;5.12.0-1.26531.101" />
	</ItemGroup>

	<!-- The Roslyn packages to collect type information from -->
	<ItemGroup>
		<RoslynPackage Include="Microsoft.CodeAnalysis.Common" />
		<RoslynPackage Include="Microsoft.CodeAnalysis.CSharp" />
		<RoslynPackage Include="Microsoft.CodeAnalysis.Workspaces.Common" />
		<RoslynPackage Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
	</ItemGroup>

	<!-- Download (but do not reference) all versions of the packages -->
	<ItemGroup>
		<PackageDownload Include="@(RoslynPackage)" Version="@(RoslynVersion->'[%(Identity)]')" />
	</ItemGroup>

	<!-- Make the versions and the package folder available to the program at runtime -->
	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>NuGetPackageRoot</_Parameter1>
			<_Parameter2>$(NuGetPackageRoot)</_Parameter2>
		</AssemblyAttribute>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>RoslynVersions</_Parameter1>
			<_Parameter2>@(RoslynVersion)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

</Project>
